---
import RadioTable from "@components/utils/radio-table/RadioTable.astro";
import RadioTableRow from "@components/utils/radio-table/RadioTableRow.astro";
import type { Props as DemiRadioButtonProps } from "@components/utils/radio-table/DemiRadioButton.astro";
import type { ColumnLabels, RowLabels, Selection, Step } from "./tabs";

interface Props {
  rowLabels: RowLabels;
  columnLabels: ColumnLabels;
}

const { rowLabels, columnLabels } = Astro.props;

function radioProps(step: Step, selection: Selection): DemiRadioButtonProps {
  return {
    id: `radio-${step}-${selection}`,
    name: `radio-${step}`,
    value: selection,
  };
}

function rowProps(selection: Selection, { firstDisabled = false } = {}) {
  return {
    label: rowLabels[selection] ?? "",
    radios: [
      { ...radioProps("first", selection), disabled: firstDisabled },
      radioProps("alt", selection),
    ],
  };
}
---

<RadioTable columns={[columnLabels.first, columnLabels.alt]}>
  <RadioTableRow {...rowProps("ms_auth")}>
    <slot name="ms_auth" />
  </RadioTableRow>

  <RadioTableRow {...rowProps("auth_app")}>
    <slot name="auth_app" />
  </RadioTableRow>

  <RadioTableRow {...rowProps("phone")}>
    <slot name="phone" />
  </RadioTableRow>

  {
    rowLabels.fido && (
      <RadioTableRow {...rowProps("fido", { firstDisabled: true })}>
        <slot name="fido" />
      </RadioTableRow>
    )
  }
  {
    rowLabels.passkey && (
      <RadioTableRow {...rowProps("passkey", { firstDisabled: true })}>
        <slot name="passkey" />
      </RadioTableRow>
    )
  }
</RadioTable>

<script>
  import { emitChangeTab, onChangeTab } from "./tabs";

  onChangeTab((step, selection) => {
    if (selection === "select") return;
    document
      .querySelectorAll<HTMLInputElement>(`input[name^="radio-${step}"]`)
      .forEach((radio) => {
        radio.checked = radio.value === selection;
      });
  });

  function onChange(this: HTMLInputElement) {
    const [, step, selection] = this.id.split("-");
    emitChangeTab(step, selection);
  }

  document.addEventListener("DOMContentLoaded", () => {
    document
      .querySelectorAll<HTMLInputElement>(`input[name^="radio"]`)
      .forEach((radio) => {
        radio.addEventListener("change", onChange);
      });
  });
</script>
